AmigaOS: a seek past the end of a file, which AmigaDOS refuses on a real
disk, made into a read of nothing or into growing the file with zeros
(gfamigaaudacity's patch 0014, as gfamigafilezilla's sqlite-0001 carries it).
Applies after sqlite-3.53.4-amiga-paths.patch.

--- a/sqlite3.c
+++ b/sqlite3.c
@@ -43688,6 +43688,38 @@
 ** are gather together into this division.
 */
 
+#if (defined(__amigaos__) || defined(SQLITE_AMIGA_HOST_SEEK)) \
+    && !defined(USE_PREAD) && !defined(USE_PREAD64)
+/*
+** AmigaOS: AmigaDOS cannot seek past the end of a file on a real disk (a
+** host folder can, so it shows only on one such as Work:), and libnix then
+** leaves the file a few bytes long, which SQLite takes for a damaged
+** database. So a read from past the end gets nothing (-2, and unixRead()
+** fills the buffer with zeros as for any short read), and a write there
+** first grows the file with zeros up to the offset. From gfamigaaudacity's
+** patch 0014, by way of gfamigafilezilla's sqlite-0001.
+** SQLITE_AMIGA_HOST_SEEK: tests/host-seektest.sh, on the host.
+*/
+# define SQLITE_AMIGA_SEEK 1
+static i64 amigaSeek(int fd, i64 iOff, int forWrite){
+  struct stat st;
+  if( osFstat(fd, &st)==0 && iOff>(i64)st.st_size ){
+    static const char zeros[4096];
+    i64 n = iOff - (i64)st.st_size;
+    if( !forWrite ) return -2;
+    if( lseek(fd, 0, SEEK_END)<0 ) return -1;
+    while( n>0 ){
+      int k = n>(i64)sizeof(zeros) ? (int)sizeof(zeros) : (int)n;
+      int w = (int)osWrite(fd, zeros, k);
+      if( w<=0 ) return -1;
+      n -= w;
+    }
+    return iOff;
+  }
+  return lseek(fd, iOff, SEEK_SET);
+}
+#endif
+
 /*
 ** Seek to the offset passed as the second argument, then read cnt
 ** bytes into pBuf. Return the number of bytes actually read.
@@ -43712,7 +43744,12 @@
     got = osPread64(id->h, pBuf, cnt, offset);
